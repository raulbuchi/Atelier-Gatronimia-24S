{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public culinary student profile without PII (email/phone excluded), including default post visibility and optional 400px compressed avatar.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "Chef student display name."
        },
        "avatarUrl": {
          "type": "string",
          "description": "Optional profile photo URL."
        },
        "avatarBase64": {
          "type": "string",
          "description": "Optional 400px EXIF-stripped JPEG avatar Base64 (<= 60KB) on white background."
        },
        "defaultVisibility": {
          "type": "string",
          "enum": ["private", "public"],
          "description": "Default visibility preference when publishing culinary records."
        },
        "bio": {
          "type": "string",
          "description": "Short culinary bio or station specialty."
        },
        "currentWeek": {
          "type": "integer",
          "description": "Current active week in the 24-week curriculum (1-24)."
        },
        "cantonFocus": {
          "type": "string",
          "description": "Preferred culinary region or canton code."
        },
        "specialtyBadge": {
          "type": "string",
          "description": "Active brigade station badge."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "currentWeek",
        "cantonFocus",
        "specialtyBadge",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortfolioPost": {
      "title": "PortfolioPost",
      "description": "Denormalized culinary portfolio and community mural post metadata with lightweight thumbnail, author avatar, Selbstkontrolle reflections, and optional Firestore image link.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Author Firebase Auth UID."
        },
        "authorName": {
          "type": "string",
          "description": "Denormalized author display name."
        },
        "authorAvatarBase64": {
          "type": "string",
          "description": "Optional denormalized 400px compressed author avatar Base64 to avoid O(N) profile lookups."
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "public"],
          "description": "Access visibility: private (owner portfolio only) or public (community mural)."
        },
        "weekNumber": {
          "type": "integer",
          "description": "Course week number (1-24)."
        },
        "cycleNumber": {
          "type": "integer",
          "description": "Course cycle number (1-4)."
        },
        "axisId": {
          "type": "integer",
          "description": "Thematic brochure axis ID (1-6)."
        },
        "materialType": {
          "type": "string",
          "enum": ["prato_final", "cortes_mep", "ficha_preenchida", "resumo_esquema"],
          "description": "Category of submitted culinary training artifact."
        },
        "recipeId": {
          "type": "string",
          "description": "Associated recipe or Ficha Técnica identifier."
        },
        "recipeTitle": {
          "type": "string",
          "description": "Denormalized recipe title."
        },
        "isSwissmilkClassic": {
          "type": "boolean",
          "description": "True if recipe belongs to the 23 Swissmilk classics."
        },
        "isChefkochV4": {
          "type": "boolean",
          "description": "True if recipe belongs to the step-by-step dossier."
        },
        "cantonCode": {
          "type": "string",
          "description": "Origin code badge if applicable."
        },
        "caption": {
          "type": "string",
          "description": "Student technical notes and observations."
        },
        "mepSummary": {
          "type": "string",
          "description": "Summary of Ficha Técnica PCC temperatures, FC, and self-assessment."
        },
        "selbstkontrolleScore": {
          "type": "integer",
          "description": "Optional bench self-assessment score (0-5)."
        },
        "erkenntnisse": {
          "type": "string",
          "description": "Optional consolidated bench learnings (Erkenntnisse)."
        },
        "offenePunkte": {
          "type": "string",
          "description": "Optional improvement targets for next execution (Offene Punkte)."
        },
        "aiFeedback": {
          "type": "string",
          "description": "Optional multimodal visual evaluation from Chef IA."
        },
        "thumbnailBase64": {
          "type": "string",
          "description": "Compact EXIF-stripped JPEG thumbnail Base64 (<80KB) for fast feed reads."
        },
        "imageLink": {
          "type": "string",
          "description": "Optional canonical Firestore resource link (firestore://portfolio_media/{mediaId}) to the full creation image."
        },
        "reactedUserIds": {
          "type": "array",
          "description": "Bounded list of UIDs who applauded this post."
        },
        "reactionCount": {
          "type": "integer",
          "description": "Denormalized count equal to reactedUserIds size."
        },
        "commentCount": {
          "type": "integer",
          "description": "Denormalized comment count."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "authorName",
        "visibility",
        "weekNumber",
        "cycleNumber",
        "axisId",
        "materialType",
        "recipeId",
        "recipeTitle",
        "isSwissmilkClassic",
        "isChefkochV4",
        "cantonCode",
        "caption",
        "mepSummary",
        "aiFeedback",
        "thumbnailBase64",
        "reactedUserIds",
        "reactionCount",
        "commentCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortfolioMedia": {
      "title": "PortfolioMedia",
      "description": "On-demand high-resolution compressed image payload (max 1200px JPEG without EXIF) captured via CameraX or Photo Picker.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "public"],
          "description": "Mirrored visibility for zero-lookup rule enforcement."
        },
        "imageBase64": {
          "type": "string",
          "description": "Compressed JPEG Base64 payload without EXIF."
        },
        "width": {
          "type": "integer",
          "description": "Compressed image width in pixels (<= 1200)."
        },
        "height": {
          "type": "integer",
          "description": "Compressed image height in pixels (<= 1200)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "visibility",
        "imageBase64",
        "width",
        "height",
        "createdAt",
        "updatedAt"
      ]
    },
    "MepSheetCloudLink": {
      "title": "MepSheetCloudLink",
      "description": "Owner-scoped Ficha Técnica cloud record associating a CameraX creation photo link with a specific technical sheet.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "recipeId": {
          "type": "string",
          "description": "Identifier of the associated Ficha Técnica in Room."
        },
        "title": {
          "type": "string",
          "description": "Title of the Ficha Técnica."
        },
        "weekNumber": {
          "type": "integer",
          "description": "Curriculum week number (1-24)."
        },
        "stationBrigade": {
          "type": "string",
          "description": "Brigade station (e.g. Saucier, Garde-manger)."
        },
        "targetServings": {
          "type": "integer",
          "description": "Scaled target servings."
        },
        "pccTargetTempC": {
          "type": "integer",
          "description": "Critical Control Point target temperature in Celsius."
        },
        "executionScore1To5": {
          "type": "integer",
          "description": "Bench self-assessment score (1-5)."
        },
        "mediaId": {
          "type": "string",
          "description": "Referenced document ID in /portfolio_media/{mediaId}."
        },
        "imageLink": {
          "type": "string",
          "description": "Canonical Firestore image link (firestore://portfolio_media/{mediaId}) for the Ficha Técnica creation photo."
        },
        "thumbnailBase64": {
          "type": "string",
          "description": "Compact 320px EXIF-stripped JPEG preview Base64 (<80KB) for single-read synchronization."
        },
        "localPhotoUri": {
          "type": "string",
          "description": "Optional device-local FileProvider URI captured by CameraX."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "recipeId",
        "title",
        "weekNumber",
        "stationBrigade",
        "targetServings",
        "pccTargetTempC",
        "executionScore1To5",
        "mediaId",
        "imageLink",
        "thumbnailBase64",
        "createdAt",
        "updatedAt"
      ]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Peer technical comment on a community mural post.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Parent post document ID."
        },
        "postOwnerId": {
          "type": "string",
          "description": "Denormalized parent post owner UID for zero-lookup list evaluation."
        },
        "postVisibility": {
          "type": "string",
          "enum": ["private", "public"],
          "description": "Denormalized parent post visibility for zero-lookup list evaluation."
        },
        "userId": {
          "type": "string",
          "description": "Comment author Firebase Auth UID."
        },
        "authorName": {
          "type": "string",
          "description": "Comment author display name."
        },
        "text": {
          "type": "string",
          "description": "Comment text (1-500 chars)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "postId",
        "postOwnerId",
        "postVisibility",
        "userId",
        "authorName",
        "text",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Owner-isolated culinary student profile documents."
    },
    "/portfolio_posts/{postId}": {
      "schema": "PortfolioPost",
      "description": "Denormalized portfolio and mural feed documents."
    },
    "/portfolio_media/{postId}": {
      "schema": "PortfolioMedia",
      "description": "Segregated compressed 1200px image payloads fetched on demand."
    },
    "/mep_sheets/{sheetDocId}": {
      "schema": "MepSheetCloudLink",
      "description": "Owner-isolated Ficha Técnica documents storing CameraX creation photo links and compact previews."
    },
    "/portfolio_posts/{postId}/comments/{commentId}": {
      "schema": "PostComment",
      "description": "Technical peer comments under a portfolio post."
    }
  }
}
